rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put the email(s) of your admin login(s) here
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@example.com'];
    }

    match /orders/{orderId} {
      // Customers can look up ONE order if they know its number (used by "My orders").
      allow get: if true;
      // Only admins can list all orders.
      allow list: if isAdmin();
      // Anyone can place a new order, but it must start unpaid and new.
      allow create: if request.resource.data.id == orderId
        && orderId.matches('TS[0-9]{6}-[A-Z0-9]{8}')
        && request.resource.data.status.pay == 'pending'
        && request.resource.data.status.order == 'new'
        && request.resource.data.payment.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.customer.email is string;
      // Only admins can change status, confirm payment or delete.
      allow update, delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
